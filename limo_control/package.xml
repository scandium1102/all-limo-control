<?xml version="1.0"?>
<package format="2">
  <name>limo_control</name>
  <version>0.1.0</version>
  <description>ROS Noetic navigation, exploration, and reactive avoidance nodes for the AgileX LIMO simulation.</description>

  <maintainer email="scandium1102@users.noreply.github.com">Scadio</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>costmap_2d</depend>
  <depend>diagnostic_updater</depend>
  <depend>dynamic_reconfigure</depend>
  <depend>geometry_msgs</depend>
  <depend>message_filters</depend>
  <depend>nav_core</depend>
  <depend>nav_msgs</depend>
  <depend>pluginlib</depend>
  <depend>roscpp</depend>
  <depend>rospy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf</depend>
  <depend>tf2_ros</depend>
  <depend>visualization_msgs</depend>

  <exec_depend>depth_image_proc</exec_depend>
  <exec_depend>depthimage_to_laserscan</exec_depend>
  <exec_depend>dwa_local_planner</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>limo_base</exec_depend>
  <exec_depend>limo_gazebo_sim</exec_depend>
  <exec_depend>move_base</exec_depend>
  <exec_depend>nodelet</exec_depend>
  <exec_depend>orbbec_camera</exec_depend>
  <exec_depend>pcl_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-rospkg</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>ros_numpy</exec_depend>
  <exec_depend>rviz</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>twist_mux</exec_depend>
  <exec_depend>ydlidar_ros_driver</exec_depend>

  <export>
    <pluginlib plugin="${prefix}/global_planner_plugin.xml"/>
  </export>
</package>
