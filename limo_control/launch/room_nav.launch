<launch>
  <arg name="map_frame" default="map"/>
  <arg name="rooms_yaml" default=""/>
  <arg name="goal_timeout" default="120.0"/>
  <arg name="wait_for_server" default="10.0"/>

  <node pkg="limo_control" type="room_navigator.py" name="room_navigator" output="screen">
    <param name="map_frame" value="$(arg map_frame)"/>
    <param name="rooms_yaml" value="$(arg rooms_yaml)"/>
    <param name="goal_timeout" value="$(arg goal_timeout)"/>
    <param name="wait_for_server" value="$(arg wait_for_server)"/>
  </node>
</launch>
