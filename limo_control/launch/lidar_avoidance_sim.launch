<launch>
  <arg name="scan_topic" default="/limo/scan"/>
  <arg name="odom_topic" default="/odom"/>
  <arg name="map_topic" default=""/>
  <arg name="cmd_vel_topic" default="/cmd_vel"/>
  <arg name="base_frame" default="base_link"/>
  <arg name="odom_frame" default="odom"/>
  <arg name="map_frame" default="map"/>
  <arg name="scan_timeout" default="0.5"/>
  <arg name="tf_timeout" default="0.2"/>

  <rosparam file="$(find limo_control)/config/lidar_avoidance.yaml" command="load" ns="limo_lidar_avoidance/avoid_params"/>
  <rosparam file="$(find limo_control)/config/dynamic_tracker.yaml" command="load" ns="limo_lidar_avoidance/tracker_params"/>
  <rosparam file="$(find limo_control)/config/frontier_explore.yaml" command="load" ns="limo_lidar_avoidance/frontier_params"/>

  <node pkg="limo_control" type="lidar_avoidance_node.py" name="limo_lidar_avoidance" output="screen">
    <param name="scan_topic" value="$(arg scan_topic)"/>
    <param name="odom_topic" value="$(arg odom_topic)"/>
    <param name="map_topic" value="$(arg map_topic)"/>
    <param name="cmd_vel_topic" value="$(arg cmd_vel_topic)"/>
    <param name="base_frame" value="$(arg base_frame)"/>
    <param name="odom_frame" value="$(arg odom_frame)"/>
    <param name="map_frame" value="$(arg map_frame)"/>
    <param name="scan_timeout" value="$(arg scan_timeout)"/>
    <param name="tf_timeout" value="$(arg tf_timeout)"/>
  </node>
</launch>
