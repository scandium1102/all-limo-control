<launch>
  <arg name="gui" default="true"/>
  <arg name="use_sim_time" default="true"/>
  <arg name="paused" default="false"/>
  <arg name="world" default="$(find limo_sim_bringup)/../worlds/hospital_world.world"/>

  <param name="use_sim_time" value="$(arg use_sim_time)"/>

  <!-- Gazebo 空世界 -->
  <include file="$(find limo_sim_bringup)/launch/world_hospital.launch">
    <arg name="world" value="$(arg world)"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="paused" value="$(arg paused)"/>
  </include>

  <!-- Spawn 模型 + diff drive 控制器 -->
  <include file="$(find limo_sim_bringup)/launch/spawn_limo.launch">
    <arg name="use_sim_time" value="$(arg use_sim_time)"/>
  </include>

  <!-- 將 gazebo /scan 轉成 /limo/scan，讓避障沿用舊 topic -->
  <node pkg="topic_tools" type="relay" name="relay_scan" args="/scan /limo/scan"/>

  <!-- 深度影像處理管線（points_filtered + depth scan） -->
  <include file="$(find limo_control)/launch/depth_cloud_pipeline.launch">
    <arg name="scan_frame" value="base_link"/>
  </include>
</launch>
